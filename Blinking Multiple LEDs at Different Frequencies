#include "stm32f4xx.h"
#include <stdint.h>

#define LED1_PIN (1U << 5) /* PA5 -> TIM2 */
#define LED2_PIN (1U << 6) /* PA6 -> TIM3 */
#define LED3_PIN (1U << 7) /* PA7 -> TIM4 */

static void GPIO_LED_Init(void)
{
    /* Aktifkan clock GPIOA pada RCC AHB1ENR */
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;

    /* Atur PA5, PA6, PA7 sebagai output push-pull tanpa pull-up/pull-down */
    GPIOA->MODER  &= ~((3U << (5 * 2)) | (3U << (6 * 2)) | (3U << (7 * 2)));
    GPIOA->MODER  |=  ((1U << (5 * 2)) | (1U << (6 * 2)) | (1U << (7 * 2)));
    GPIOA->OTYPER &= ~(LED1_PIN | LED2_PIN | LED3_PIN);
    GPIOA->PUPDR  &= ~((3U << (5 * 2)) | (3U << (6 * 2)) | (3U << (7 * 2)));
}

static void TIM2_Init_Config(void)
{
    /* Asumsi f_tim = 16 MHz: PSC = 15999 -> 1 kHz, ARR = 499 -> overflow tiap 500 ms */
    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;
    TIM2->CR1 = 0U;
    TIM2->PSC = 15999U;
    TIM2->ARR = 499U;
    TIM2->DIER |= TIM_DIER_UIE;
    TIM2->EGR  |= TIM_EGR_UG;
    TIM2->SR   &= ~TIM_SR_UIF;

    NVIC_SetPriority(TIM2_IRQn, 2);
    NVIC_EnableIRQ(TIM2_IRQn);

    TIM2->CR1 |= TIM_CR1_CEN;
}

static void TIM3_Init_Config(void)
{
    /* Asumsi f_tim = 16 MHz: PSC = 1599 -> 10 kHz, ARR = 999 -> overflow tiap 100 ms */
    RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;
    TIM3->CR1 = 0U;
    TIM3->PSC = 1599U;
    TIM3->ARR = 999U;
    TIM3->DIER |= TIM_DIER_UIE;
    TIM3->EGR  |= TIM_EGR_UG;
    TIM3->SR   &= ~TIM_SR_UIF;

    NVIC_SetPriority(TIM3_IRQn, 3);
    NVIC_EnableIRQ(TIM3_IRQn);

    TIM3->CR1 |= TIM_CR1_CEN;
}

static void TIM4_Init_Config(void)
{
    /* Asumsi f_tim = 16 MHz: PSC = 1599 -> 10 kHz, ARR = 499 -> overflow tiap 50 ms */
    RCC->APB1ENR |= RCC_APB1ENR_TIM4EN;
    TIM4->CR1 = 0U;
    TIM4->PSC = 1599U;
    TIM4->ARR = 499U;
    TIM4->DIER |= TIM_DIER_UIE;
    TIM4->EGR  |= TIM_EGR_UG;
    TIM4->SR   &= ~TIM_SR_UIF;

    NVIC_SetPriority(TIM4_IRQn, 4);
    NVIC_EnableIRQ(TIM4_IRQn);

    TIM4->CR1 |= TIM_CR1_CEN;
}

void TIM2_IRQHandler(void)
{
    if (TIM2->SR & TIM_SR_UIF)
    {
        TIM2->SR &= ~TIM_SR_UIF;
        GPIOA->ODR ^= LED1_PIN;
    }
}

void TIM3_IRQHandler(void)
{
    if (TIM3->SR & TIM_SR_UIF)
    {
        TIM3->SR &= ~TIM_SR_UIF;
        GPIOA->ODR ^= LED2_PIN;
    }
}

void TIM4_IRQHandler(void)
{
    if (TIM4->SR & TIM_SR_UIF)
    {
        TIM4->SR &= ~TIM_SR_UIF;
        GPIOA->ODR ^= LED3_PIN;
    }
}

int main(void)
{
    GPIO_LED_Init();
    TIM2_Init_Config();
    TIM3_Init_Config();
    TIM4_Init_Config();

    while (1)
    {
    }
}
