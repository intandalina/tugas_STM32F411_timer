#include "stm32f4xx.h"
#include <stdint.h>

#define LED_PIN (1U << 5) /* PA5 */
#define BTN_PIN 0U        /* PA0 -> EXTI0 */

volatile uint8_t btn_exti_flag    = 0U;
volatile uint8_t debounce_done_flag = 0U;

static void IO_EXTI0_Init(void)
{
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

    /* PA5 sebagai output push-pull */
    GPIOA->MODER  &= ~(3U << (5 * 2));
    GPIOA->MODER  |=  (1U << (5 * 2));
    GPIOA->OTYPER &= ~LED_PIN;

    /* PA0 sebagai input dengan pull-up internal */
    GPIOA->MODER &= ~(3U << (BTN_PIN * 2));
    GPIOA->PUPDR &= ~(3U << (BTN_PIN * 2));
    GPIOA->PUPDR |=  (1U << (BTN_PIN * 2));

    /* Hubungkan EXTI0 ke Port A */
    SYSCFG->EXTICR[0] &= ~(0xFU << 0);

    /* Aktifkan EXTI0 pada falling edge */
    EXTI->IMR  |=  (1U << BTN_PIN);
    EXTI->FTSR |=  (1U << BTN_PIN);
    EXTI->RTSR &= ~(1U << BTN_PIN);
    EXTI->PR    =  (1U << BTN_PIN);

    NVIC_SetPriority(EXTI0_IRQn, 2);
    NVIC_EnableIRQ(EXTI0_IRQn);
}

static void TIM2_Debounce_Init(void)
{
    /* Asumsi f_tim = 16 MHz: PSC = 1599 -> 10 kHz (0.1 ms/tick), ARR = 199 -> 20 ms */
    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;
    TIM2->CR1  = 0U;
    TIM2->CR1 |= TIM_CR1_OPM;
    TIM2->PSC  = 1599U;
    TIM2->ARR  = 199U;
    TIM2->DIER |= TIM_DIER_UIE;

    NVIC_SetPriority(TIM2_IRQn, 3);
    NVIC_EnableIRQ(TIM2_IRQn);
}

static void TIM2_Start_Debounce(void)
{
    TIM2->CNT = 0U;
    TIM2->SR &= ~TIM_SR_UIF;
    TIM2->EGR |= TIM_EGR_UG;
    TIM2->SR &= ~TIM_SR_UIF;
    TIM2->CR1 |= TIM_CR1_CEN;
}

void EXTI0_IRQHandler(void)
{
    if (EXTI->PR & (1U << BTN_PIN))
    {
        EXTI->PR = (1U << BTN_PIN);
        btn_exti_flag = 1U;
    }
}

void TIM2_IRQHandler(void)
{
    if (TIM2->SR & TIM_SR_UIF)
    {
        TIM2->SR &= ~TIM_SR_UIF;
        debounce_done_flag = 1U;
    }
}

int main(void)
{
    IO_EXTI0_Init();
    TIM2_Debounce_Init();

    while (1)
    {
        if (btn_exti_flag)
        {
            btn_exti_flag = 0U;
            TIM2_Start_Debounce();
        }

        if (debounce_done_flag)
        {
            debounce_done_flag = 0U;

            if (!(GPIOA->IDR & (1U << BTN_PIN)))
            {
                GPIOA->ODR ^= LED_PIN;
            }
        }
    }
}
